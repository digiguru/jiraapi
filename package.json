{
  "name": "jiraapi",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "express": "^4.21.2",
    "jira-client": "^8.2.2",
    "request": "^2.88.2"
  },
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "jest": {
    "verbose": true,
    "testMatch": [
      "**/*.test.mjs"
    ]
  },
  "scripts": {
    "start": "node src/server.mjs",
    "server": "node src/server.mjs",
    "server-watch": "nodemon -e mjs,js src/server.mjs",
    "lint": "eslint src scripts",
    "build": "node scripts/build-check.mjs",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --runInBand --reporters=default --reporters=jest-junit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "jest-junit": {
    "outputDirectory": "results"
  },
  "proxy": "http://localhost:4000",
  "devDependencies": {
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  }
}
